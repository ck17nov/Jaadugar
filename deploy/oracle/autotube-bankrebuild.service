[Unit]
# Rebuilds the live database from the script bank shipped in git.
#
# It USED TO fold in the autofill's output from workspace/bank-gen. The
# autofill is gone - the owner supplies every script - so this now has one
# job: make the database agree with banks/gen after a deploy. No
# --extra-stage, because anything outside the checkout arrived without the
# owner asking, which is the thing that was removed.
Description=Jaadugar bank rebuild (database follows the shipped bank)
After=network-online.target

[Service]
Type=oneshot
User=autotube
Group=autotube
WorkingDirectory=/opt/autotube
EnvironmentFile=/opt/autotube/.env

# --no-promote because banks/ here IS the git checkout, and rewriting it
# would dirty the tree and break every future deploy. The staged files
# remain the source; only the database is rebuilt.
ExecStart=/opt/autotube/.venv/bin/python scripts/bank_rebuild.py \
    --confirm --no-promote

Nice=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=autotube-bankrebuild

[Install]
WantedBy=multi-user.target
