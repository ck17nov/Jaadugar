[Unit]
# Fills the script bank on the SERVER, so topping it up never depends on a
# laptop being switched on. It talks only to the free LLM tier the rest of
# the system already uses, and every entry it accepts goes through the same
# import gates as a hand-written one.
Description=Jaadugar script bank autofill
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=autotube
Group=autotube
WorkingDirectory=/opt/autotube
EnvironmentFile=/opt/autotube/.env

# STAGE OUTSIDE THE CHECKOUT. Deploys run `git pull --ff-only`, which
# refuses a dirty working tree, so appending into banks/gen here would
# break every future deploy. The staged files are collected from the
# workspace instead.
ExecStart=/opt/autotube/.venv/bin/python scripts/bank_autofill.py run \
    --group kids --shorts 50 --longform 50 --hours 23 \
    --stage-dir /opt/autotube/workspace/bank-gen

# Running out of free quota is the NORMAL way this exits, not a fault, so
# it always restarts - and waits half an hour first, because the thing it
# is waiting for is a daily reset.
Restart=always
RestartSec=1800

# Never at the expense of the thing the phone talks to. Rendering and the
# API come first; this is the lowest-value work on the box.
Nice=15
CPUWeight=20
IOWeight=20

StandardOutput=journal
StandardError=journal
SyslogIdentifier=autotube-autofill

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
ReadWritePaths=/opt/autotube

[Install]
WantedBy=multi-user.target
