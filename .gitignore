# ---- Python ----
.venv/
__pycache__/
*.pyc
.pytest_cache/

# ---- Secrets (never commit) ----
#
# .secrets/ holds the credentials this project needs to reach machines it
# owns: the Oracle SSH key and the Google OAuth client secrets. They live
# INSIDE the repo so that moving or clearing Downloads cannot break a
# deploy, and they are ignored here so that convenience never turns into a
# published private key. THIS REPOSITORY IS PUBLIC.
#
# The directory rule is what protects the files in .secrets/ - git does not
# descend into an ignored directory, so the patterns below are never even
# consulted for them. (An earlier comment here claimed three patterns made
# it harder to bypass with `git add -f`. That was wrong: -f overrides every
# matching rule, so pattern count buys nothing against it.)
#
# The patterns below exist for the mistake that is actually likely: a key
# saved somewhere ELSE in the tree, in a hurry, under whatever name the
# download gave it. Names matter here - an audit found that `oracle_private`,
# `deploy_id` and `credentials.yaml` were all stageable.
.secrets/
*.key
!*.key.pub
*.pem
*.ppk
*_rsa
*_dsa
*_ecdsa
*_ed25519
id_rsa*
id_ed25519*
*private*key*
credentials*.json
credentials*.yaml
credentials*.yml
*refresh_token*
.env
*token*.json
client_secret*.json

# ---- Runtime output ----
workspace/
*.db
*.db-journal

# ---- Android ----
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/.idea/
*.apk
*.aab

# ---- Large / user-supplied assets ----
# Order matters in .gitignore: the negation must follow the pattern it undoes.
assets/music/*
!assets/music/.gitkeep
assets/piper/

# Copied system fonts are not redistributable - keep them local.
assets/fonts/ariblk.ttf
assets/fonts/impact.ttf
assets/fonts/seguibl.ttf
assets/fonts/DejaVuSans-Bold.ttf
assets/fonts/LiberationSans-Bold.ttf

# Kotlin compiler scratch output (build noise)
android/.kotlin/

# Stray probe output. Research subagents curl endpoints and occasionally
# write the response into the project root; one such file (an OVH API error)
# was committed by a "git add -A".
*.bin
_e2e*.py

# Scratch probes written by audit subagents mid-investigation.
_probe_*.py
_render_bank.py
_verify_*.py
_genprompts.py
_dis_check.py
_thumb*.py
_peek.py
_bank_write.py

# Names the deployed host and its key path. Local only.
DEPLOYMENT.local.md
HANDOVER.local.md

# Batch prompts are generated from the bank on demand; only the JSONL
# batches they produce are worth keeping.
banks/gen/_prompt-*.txt
