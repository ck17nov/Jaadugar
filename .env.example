# ============================================================
#  AutoTube AI - environment template.  Copy to `.env`.
#  NEVER commit the real .env.  See docs/SECURITY.md
# ============================================================

# ---------- YouTube Data / Analytics API (required) ----------
# Free. Google Cloud project -> enable "YouTube Data API v3".
# API key is used for read-only research (search/videos/channels).
YOUTUBE_API_KEY=

# OAuth client (type: Desktop app) for upload + own-channel analytics.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# ---------- LLM providers (pick at least one; all have free tiers) ----------
# Groq: free tier, no credit card. https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Google AI Studio (Gemini): free tier, no credit card.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Ollama: fully local, no key, no cost. Install from ollama.com
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b

# ---------- Stock imagery (optional, free keys, no credit card) ----------
PEXELS_API_KEY=
PIXABAY_API_KEY=

# ---------- Backend API auth (protects your own endpoints) ----------
# Long random string. The Android app sends this as `X-API-Key`.
AUTOTUBE_API_TOKEN=

# ---------- Behaviour ----------
DRY_RUN=true
# Set both of these to actually upload.
#
# With FORCE_PRIVATE=false - the default below - an approved video, or any
# video an AUTO-mode automation finishes, is PUBLIC on the channel. There is
# no second gate after that.
#
# Set FORCE_PRIVATE=true to rehearse instead: every video is inserted as
# private with no publishAt, so you can confirm uploading works without a
# subscriber seeing anything. It overrides youtube.default_privacy entirely,
# so leaving it on is why "default_privacy: public" appears to do nothing.
UPLOAD_ENABLED=false
# Optional: a better image generator.
#
# The keyless default (Pollinations/sana) has a painterly house style and will
# not draw flat-colour anime line art whatever the prompt says - measured
# across three prompt shapes on a fixed seed. A free Hugging Face account and
# token lets visuals.ai_image_backend=huggingface run any text-to-image model,
# including anime-tuned ones, which is what a Ghibli-style channel needs.
HF_API_TOKEN=
# Cloudflare Workers AI - THE ONLY FREE ROUTE TO USABLE IMAGES.
#
# Not a nice-to-have. Without these two values the pipeline falls back to the
# keyless generator, which was measured against its live endpoint and is
# unfit: a hard 0.59 megapixel cap however large an image you ask for, one
# fixed model (the `model` parameter is ignored - seven different names
# returned seven byte-identical images), art direction ignored, a watermark
# applied whatever you ask, and a bedtime-story prompt naming a small girl
# answered with an adult woman in a slip dress. See the measurements in
# engine/visuals/ai_image.py.
#
# Free tier: 10,000 neurons a day, no card required. FLUX is documented at
# 4.8 neurons per 512x512 tile plus 9.6 per step, so a 1080x1920 frame at 4
# steps is ~96 neurons - about 100 images a day, or ten 10-scene Shorts.
# SDXL is not in the published pricing table; the daily allowance has been
# ample in practice.
#
# Both values come from ONE dashboard page:
#   https://dash.cloudflare.com/?to=/:account/ai/workers-ai
#   -> Use REST API -> Create a Workers AI API Token -> Create -> copy it.
#   The Account ID is shown on that same page.
# A hand-made token needs Workers AI Read AND Edit.
#
# No config change is needed: visuals.ai_image_backend defaults to "auto",
# which picks Cloudflare up as soon as these are set.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
FORCE_PRIVATE=false
AUTOTUBE_CONFIG=./config.yaml
